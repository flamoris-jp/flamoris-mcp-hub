      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  "capabilities.get": {
    "input_schema": {
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        }
      },
      "required": [
        "capability_id"
      ],
      "title": "capabilityArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
