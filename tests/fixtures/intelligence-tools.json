  "inference.execute": {
    "input_schema": {
      "properties": {
        "request": {
          "additionalProperties": false,
          "properties": {
            "model_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Model Id",
              "type": "string"
            },
            "input": {
              "maxLength": 262144,
              "minLength": 1,
              "title": "Input",
              "type": "string"
            },
            "instruction": {
              "default": "",
              "maxLength": 262144,
              "title": "Instruction",
              "type": "string"
            },
            "capability_id": {
              "default": "text.generate",
              "enum": [
                "text.generate",
                "reasoning.generate",
                "code.generate"
              ],
              "title": "Capability Id",
              "type": "string"
            },
            "max_output_tokens": {
              "default": 1024,
              "maximum": 32768,
              "minimum": 1,
              "title": "Max Output Tokens",
              "type": "integer"
            },
            "temperature": {
              "default": 0.7,
              "maximum": 2,
              "minimum": 0,
              "title": "Temperature",
              "type": "number"
            },
            "timeout_seconds": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 300,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Timeout Seconds"
            }
          },
          "required": [
            "model_id",
            "input"
          ],
          "title": "InferenceRequest",
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "title": "executeArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  }
}
