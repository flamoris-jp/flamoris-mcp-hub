# Hub listener
FLAMORIS_MCP_HUB_PORT=8765
FLAMORIS_MCP_HUB_BIND=127.0.0.1
# Required for every Hub HTTP client, independently of upstream credentials.
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(32))'
FLAMORIS_MCP_HUB_CLIENT_TOKEN=
# Exact external Host values accepted through a tunnel/proxy (comma-separated)
FLAMORIS_MCP_HUB_ALLOWED_HOSTS=
# Browser Origin values if required (comma-separated)
FLAMORIS_MCP_HUB_ALLOWED_ORIGINS=

# Hub -> upstream MCP credentials (Streamable HTTP).
# Keep real values only in .env. These are separate from Hub client tokens.
# Generation MCP itself does not require a token. Add an environment variable
# only if an authenticated proxy protects your upstream deployment.
CUTWORK_MCP_API_KEY=
KACHINCO_MCP_API_KEY=

# Desktop -> Hub connector credentials (reverse WebSocket).
# Generate a unique random token for each connector and store the same value
# in the desktop application's Windows Credential Manager.
CUTWORK_CONNECTOR_TOKEN=
FLAMORIS2D_CONNECTOR_TOKEN=
KACHINCO_CONNECTOR_TOKEN=
